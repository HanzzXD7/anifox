
module.exports = async (req, res) => {
  res.setHeader(
    'Cache-Control',
    's-maxage=900, stale-while-revalidate=3600'
  );

  try {
    const channelId = 'UCxxnxya_32jcKj4yN1_kD7A';
    const videos = await getVideos(channelId);

    res.status(200).json({
      source: 'Muse Indonesia',
      videos
    });
  } catch (error) {
    res.status(502).json({
      error: 'Muse feed unavailable',
      videos: []
    });
  }
};

async function getVideos(channelId) {
  const url =
    `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`;

  const response = await fetch(url, {
    headers: { 'User-Agent': 'Mozilla/5.0' }
  });

  if (!response.ok) {
    throw new Error('YouTube RSS error');
  }

  const xml = await response.text();
  return parseFeed(xml);
}

function parseFeed(xml) {
  const entries = xml.match(/<entry>[\s\S]*?<\/entry>/g) || [];

  return entries.map(entry => {
    const videoId = getTag(entry, 'yt:videoId');

    return {
      videoId,
      title: getTag(entry, 'title'),
      published: getTag(entry, 'published'),
      thumbnail: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
      url: `https://www.youtube.com/watch?v=${videoId}`,
      source: 'Muse Indonesia'
    };
  }).filter(video =>
    /^[A-Za-z0-9_-]{11}$/.test(video.videoId)
  );
}

function getTag(xml, tag) {
  const escaped = tag.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = xml.match(
    new RegExp(`<${escaped}>([\\s\\S]*?)<\\/${escaped}>`)
  );

  return match ? decodeXML(match[1].trim()) : '';
}

function decodeXML(value) {
  return value
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&amp;/g, '&');
}
